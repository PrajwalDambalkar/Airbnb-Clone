# AWS Deployment Environment Variables
# Copy this file to .env.aws and fill in your actual values

# ===========================================
# IMPORTANT: Security Notice
# ===========================================
# Do NOT commit .env.aws to Git!
# This file contains sensitive credentials
# ===========================================

# MongoDB Connection Strings (Use your MongoDB Atlas credentials)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/airbnb_db?retryWrites=true&w=majority
TRAVELER_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/airbnb_db?retryWrites=true&w=majority
OWNER_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/airbnb_db?retryWrites=true&w=majority
PROPERTY_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/airbnb_properties?retryWrites=true&w=majority
BOOKING_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/airbnb_db?retryWrites=true&w=majority

# Session Secret (Change this to a random string)
SESSION_SECRET=your-super-secret-session-key-change-this-123456

# Node Environment
NODE_ENV=production

# EC2 Public IP (You'll get this after launching EC2 instance)
# Replace <EC2-PUBLIC-IP> in docker-compose.aws.yml with this value
EC2_PUBLIC_IP=XX.XX.XX.XX

# ===========================================
# Optional: If you want to use agent service
# ===========================================
# AGENT_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/airbnb_db?retryWrites=true&w=majority
# AGENT_SERVICE_SECRET=your-agent-service-secret-key
# TAVILY_API_KEY=your-tavily-api-key-if-needed

# ===========================================
# AWS Configuration (For reference - not used by app)
# ===========================================
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
